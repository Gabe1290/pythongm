{
  "name": "obj_player",
  "asset_type": "object",
  "sprite": "spr_player",
  "visible": true,
  "solid": false,
  "persistent": false,
  "depth": -10,
  "events": {
    "create": {
      "actions": [
        {
          "action": "set_variable",
          "parameters": {
            "variable": "fire_cooldown",
            "value": "0",
            "scope": "self"
          }
        },
        {
          "action": "set_variable",
          "parameters": {
            "variable": "bomb_cooldown",
            "value": "0",
            "scope": "self"
          }
        }
      ]
    },
    "game_start": {
      "actions": [
        {
          "action": "set_score",
          "parameters": {
            "value": "0",
            "relative": false
          }
        },
        {
          "action": "set_lives",
          "parameters": {
            "value": "3",
            "relative": false
          }
        },
        {
          "action": "set_background",
          "parameters": {
            "background": "bg_ground",
            "visible": true,
            "foreground": false,
            "tiled_h": true,
            "tiled_v": true,
            "hspeed": "0",
            "vspeed": "2"
          }
        },
        {
          "action": "set_alarm",
          "parameters": {
            "alarm_number": "0",
            "steps": "40"
          }
        },
        {
          "action": "set_alarm",
          "parameters": {
            "alarm_number": "1",
            "steps": "70"
          }
        }
      ]
    },
    "step": {
      "actions": [
        {
          "action": "if_condition",
          "parameters": {
            "condition_type": "expression",
            "expression": "self.fire_cooldown > 0",
            "then_actions": [
              {
                "action": "set_variable",
                "parameters": {
                  "variable": "fire_cooldown",
                  "value": "-1",
                  "scope": "self",
                  "relative": true
                }
              }
            ],
            "else_actions": []
          }
        },
        {
          "action": "if_condition",
          "parameters": {
            "condition_type": "expression",
            "expression": "self.bomb_cooldown > 0",
            "then_actions": [
              {
                "action": "set_variable",
                "parameters": {
                  "variable": "bomb_cooldown",
                  "value": "-1",
                  "scope": "self",
                  "relative": true
                }
              }
            ],
            "else_actions": []
          }
        },
        {
          "action": "if_condition",
          "parameters": {
            "condition_type": "expression",
            "expression": "self.x < 4",
            "then_actions": [
              {
                "action": "jump_to_position",
                "parameters": {
                  "x": "4",
                  "y": "self.y",
                  "relative": false
                }
              }
            ],
            "else_actions": []
          }
        },
        {
          "action": "if_condition",
          "parameters": {
            "condition_type": "expression",
            "expression": "self.x > 452",
            "then_actions": [
              {
                "action": "jump_to_position",
                "parameters": {
                  "x": "452",
                  "y": "self.y",
                  "relative": false
                }
              }
            ],
            "else_actions": []
          }
        },
        {
          "action": "if_condition",
          "parameters": {
            "condition_type": "expression",
            "expression": "self.y < 4",
            "then_actions": [
              {
                "action": "jump_to_position",
                "parameters": {
                  "x": "self.x",
                  "y": "4",
                  "relative": false
                }
              }
            ],
            "else_actions": []
          }
        },
        {
          "action": "if_condition",
          "parameters": {
            "condition_type": "expression",
