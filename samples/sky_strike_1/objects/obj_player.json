            "action": "jump_to_position",
            "parameters": {
              "x": "0",
              "y": "-5",
              "relative": true
            }
          }
        ]
      },
      "down": {
        "actions": [
          {
            "action": "jump_to_position",
            "parameters": {
              "x": "0",
              "y": "5",
              "relative": true
            }
          }
        ]
      },
      "s": {
        "actions": [
          {
            "action": "jump_to_position",
            "parameters": {
              "x": "0",
              "y": "5",
              "relative": true
            }
          }
        ]
      },
      "space": {
        "actions": [
          {
            "action": "if_condition",
            "parameters": {
              "condition_type": "expression",
              "expression": "self.fire_cooldown <= 0",
              "then_actions": [
                {
                  "action": "create_instance",
                  "parameters": {
                    "object": "obj_bullet",
                    "x": "self.x + 10",
