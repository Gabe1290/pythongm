    },
    "alarm_1": {
      "actions": [
        {
          "action": "create_instance",
          "parameters": {
            "object": "obj_ground_target",
            "x": "irandom(444) + 4",
            "y": "-24",
            "relative": false
          }
        },
        {
          "action": "set_alarm",
          "parameters": {
            "alarm_number": "1",
            "steps": "70"
