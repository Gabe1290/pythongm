{
  "name": "obj_person",
  "asset_type": "object",
  "sprite": "spr_person",
  "visible": true,
  "solid": false,
  "persistent": false,
  "depth": 0,
  "parent": "",
  "events": {
    "create": {
      "actions": [
        {
          "action": "enable_raycast_view",
          "parameters": {
            "camera_object": "",
            "fov": "66",
            "cell_size": "32",
            "render_distance": "20",
            "wall_texture": "spr_wall_texture",
            "sky_texture": "",
            "floor_texture": "spr_floor",
            "ceiling_texture": "spr_ceiling",
            "wall_color": "#993333",
            "floor_color": "#464632",
            "ceiling_color": "#87CEEB",
            "wall_height": "3",
            "max_step": "12"
          }
        },
        {
          "action": "set_facing_angle",
          "parameters": {
            "angle": "90",
            "relative": false
          }
        }
      ]
    },
    "keyboard": {
      "up": {
        "actions": [
          {
            "action": "set_direction_speed",
            "parameters": {
              "direction": "facing_angle",
              "speed": "3"
            }
          }
        ]
      },
      "down": {
        "actions": [
          {
            "action": "set_direction_speed",
            "parameters": {
              "direction": "facing_angle+180",
              "speed": "3"
            }
          }
        ]
      },
      "left": {
        "actions": [
          {
            "action": "set_facing_angle",
            "parameters": {
              "angle": "3",
              "relative": true
            }
          }
        ]
      },
      "right": {
        "actions": [
          {
            "action": "set_facing_angle",
            "parameters": {
              "angle": "-3",
              "relative": true
            }
          }
        ]
      },
      "nokey": {
        "actions": [
          {
            "action": "set_direction_speed",
            "parameters": {
              "direction": "0",
              "speed": "0"
            }
          }
        ]
      }
    },
    "collision_with_obj_wall": {
      "actions": [],
      "target_object": "obj_wall"
    },
    "collision_with_obj_gate_a": {
      "actions": [
        {
          "action": "go_to_room_seamlessly",
          "parameters": {
            "room": "room1",
            "marker": "obj_junction"
          }
        }
      ],
      "target_object": "obj_gate_a"
    },
    "collision_with_obj_gate_b": {
      "actions": [
        {
          "action": "go_to_room_seamlessly",
          "parameters": {
            "room": "room0",
            "marker": "obj_junction"
          }
        }
      ],
      "target_object": "obj_gate_b"
    },
    "collision_with_obj_goal": {
      "actions": [
        {
          "action": "show_message",
          "parameters": {
            "message": "You walked through the junction without noticing!",
            "message_translations": {
              "fr": "Tu as traversé la jonction sans t'en apercevoir !"
            }
          }
        },
        {
          "action": "restart_game",
          "parameters": {}
        }
      ],
      "target_object": "obj_goal"
    }
  }
}
