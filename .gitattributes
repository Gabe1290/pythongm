# Handle line endings automatically for files detected as text
* text=auto

# Force Python files to use LF everywhere
*.py text eol=lf
*.ts text eol=lf
*.qm binary

# Vendored micro:bit firmware (extensions/microbit/export/firmware/): plain
# ASCII Intel Hex text, but treated as binary so git never touches its line
# endings -- its committed bytes must match the documented sha256 in
# THIRD_PARTY_LICENSES.md exactly, on every platform.
extensions/microbit/export/firmware/*.hex binary

# Force Markdown (incl. wiki/ sources) to LF so wiki sync doesn't report
# spurious CRLF-vs-LF drift on Windows checkouts
*.md text eol=lf
