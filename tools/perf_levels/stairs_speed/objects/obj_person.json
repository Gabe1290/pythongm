{
  "name": "obj_person",
  "asset_type": "object",
  "sprite": "spr_person",
  "visible": true,
  "solid": false,
  "persistent": false,
  "depth": 0,
  "parent": "",
  "events": {
    "create": {
      "actions": [
        {
          "action": "enable_raycast_view",
          "parameters": {
            "camera_object": "",
            "fov": "66",
            "cell_size": "32",
            "render_distance": "20",
            "wall_texture": "spr_wall_texture",
            "sky_texture": "",
            "floor_texture": "spr_floor",
            "ceiling_texture": "spr_ceiling",
            "wall_color": "#993333",
            "floor_color": "#464632",
            "ceiling_color": "#87CEEB",
            "wall_height": "3",
            "max_step": "12"
          }
        },
        {
          "action": "set_facing_angle",
          "parameters": {
            "angle": "0",
            "relative": false
          }
        }
      ]
    },
    "keyboard": {
      "up": {
        "actions": [
          {
            "action": "set_direction_speed",
            "parameters": {
              "direction": "facing_angle",
              "speed": "3"
            }
          }
        ]
      },
      "down": {
        "actions": [
          {
            "action": "set_direction_speed",
            "parameters": {
              "direction": "facing_angle+180",
              "speed": "3"
            }
          }
        ]
      },
      "left": {
        "actions": [
          {
            "action": "set_facing_angle",
            "parameters": {
              "angle": "3",
              "relative": true
            }
          }
        ]
      },
      "right": {
        "actions": [
          {
            "action": "set_facing_angle",
            "parameters": {
              "angle": "-3",
              "relative": true
            }
          }
        ]
      },
      "nokey": {
        "actions": [
          {
            "action": "set_direction_speed",
            "parameters": {
              "direction": "0",
              "speed": "0"
            }
          }
        ]
      }
    },
    "keyboard_press": {
      "s": {
        "actions": [
          {
            "action": "goto_room",
            "parameters": {
              "room": "salle_escalier",
              "transition": "none"
            }
          }
        ]
      },
      "f": {
        "actions": [
          {
            "action": "goto_room",
            "parameters": {
              "room": "salle_plate",
              "transition": "none"
            }
          }
        ]
      }
    },
    "collision_with_obj_wall": {
      "actions": [],
      "target_object": "obj_wall"
    },
    "draw": {
      "actions": [
        {
          "action": "execute_code",
          "parameters": {
            "code": "clock = game.clock\nhist = getattr(self, 'perf_hist', None)\nif hist is None:\n    hist = []\n    self.perf_hist = hist\nhist.append(clock.get_rawtime())\ndel hist[:-30]\nms = sum(hist) / len(hist)\nlabel = 'ESCALIER' if game.current_room.name == 'salle_escalier' else 'SOL PLAT'\nself.perf_text = '%s   %.1f ms/image   %d i/s      [S] escalier   [F] plat' % (label, ms, clock.get_fps())\n"
          }
        },
        {
          "action": "draw_text",
          "parameters": {
            "x": "8",
            "y": "8",
            "text": "perf_text",
            "color": "#ffff00"
          }
        }
      ]
    }
  }
}
