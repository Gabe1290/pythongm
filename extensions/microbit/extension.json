{
    "name": "micro:bit",
    "version": "0.1.0",
    "author": "PyGameMaker",
    "description": "BBC micro:bit simulator: a board drawn in the game window with its LED display, buttons, sensors and radio. Being built stage by stage -- see docs/MICROBIT_EXTENSION_PLAN.md.",
    "enabled": true,
    "provides_actions": [
        "microbit_show_image",
        "microbit_scroll_text",
        "microbit_show_number",
        "microbit_set_pixel",
        "microbit_clear_display",
        "microbit_set_brightness",
        "microbit_play_tone",
        "microbit_play_melody",
        "microbit_stop_sound",
        "microbit_radio_set_group",
        "microbit_radio_send",
        "microbit_read_sensor",
        "microbit_if_button",
        "microbit_if_gesture",
        "microbit_if_tilt",
        "microbit_if_pixel"
    ],
    "provides_events": [
        "microbit_button_a",
        "microbit_button_b",
        "microbit_button_ab",
        "microbit_logo_touched",
        "microbit_pin_0",
        "microbit_pin_1",
        "microbit_pin_2",
        "microbit_gesture_shake",
        "microbit_gesture_logo_up",
        "microbit_gesture_logo_down",
        "microbit_gesture_tilt_left",
        "microbit_gesture_tilt_right",
        "microbit_gesture_screen_up",
        "microbit_gesture_screen_down",
        "microbit_gesture_free_fall",
        "microbit_gesture_2g",
        "microbit_gesture_3g",
        "microbit_gesture_6g",
        "microbit_gesture_8g",
        "microbit_loud_sound",
        "microbit_quiet_sound",
        "microbit_display_done",
        "microbit_radio_received",
        "microbit_sound_done"
    ]
}
